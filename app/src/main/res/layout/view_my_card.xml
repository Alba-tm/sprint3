<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/titulo"
            android:textSize="@dimen/text_card_title" />

        <TextView
            android:id="@+id/tvCardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/subtitulo"
            android:textSize="@dimen/text_card_subtitle" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivCardImage"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_image_height"
        android:background="@drawable/shape_imagen_velada"
        android:importantForAccessibility="no"
        android:padding="@dimen/img_padding"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvCardDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/line_spacing_extra"
        android:padding="@dimen/card_padding"
        android:textColor="@color/subtitulo"
        android:textSize="@dimen/text_card_description" />

    <LinearLayout
        android:id="@+id/llCardActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:paddingBottom="@dimen/card_padding"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCardPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/card_gap"
            android:layout_weight="1"
            android:background="@drawable/shape_boton_velada"
            android:minHeight="@dimen/card_button_min_height"
            android:textAllCaps="false"
            android:textColor="@color/texto_boton"
            android:textSize="@dimen/text_card_button"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCardSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_gap"
            android:layout_weight="1"
            android:background="@drawable/shape_boton_secundario"
            android:minHeight="@dimen/card_button_min_height"
            android:textAllCaps="false"
            android:textColor="@color/velada_dorado"
            android:textSize="@dimen/text_card_button"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>