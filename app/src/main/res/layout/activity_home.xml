<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/velada_fondo"
    android:fillViewport="true"
    tools:context=".HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/margin_large">

        <ImageView
            android:id="@+id/ivVelada"
            android:layout_width="match_parent"
            android:layout_height="@dimen/img_hero_height"
            android:background="@drawable/shape_imagen_velada"
            android:contentDescription="@string/velada_image_desc"
            android:padding="@dimen/img_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/velada_vii" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.01"
            android:shadowColor="@color/velada_brillo"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12"
            android:text="@string/velada_title"
            android:textAlignment="center"
            android:textColor="@color/titulo"
            android:textSize="@dimen/text_title" />

        <View
            android:layout_width="@dimen/linea_ancho"
            android:layout_height="@dimen/linea_alto"
            android:layout_marginTop="@dimen/margin_medium"
            android:background="@drawable/shape_linea_dorada"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:fontFamily="sans-serif-light"
            android:lineSpacingExtra="@dimen/line_spacing_extra"
            android:text="@string/subtitle"
            android:textAlignment="center"
            android:textColor="@color/subtitulo"
            android:textSize="@dimen/text_subtitle" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_extra_large"
            android:layout_marginEnd="@dimen/margin_medium"
            android:background="@drawable/shape_boton_velada"
            android:minHeight="@dimen/button_min_height"
            android:paddingStart="@dimen/margin_large"
            android:paddingEnd="@dimen/margin_large"
            android:text="@string/boton"
            android:textAllCaps="false"
            android:textColor="@color/texto_boton"
            android:textSize="@dimen/text_button"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>